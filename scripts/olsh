#!/usr/bin/env bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -z "$OL_IMAGE" ] || [ -z "$PDK_ROOT" ]; then
    source "$SCRIPT_DIR/env.sh"
fi

if [ -z "$OL_IMAGE" ]; then
    # no LibreLane image: run natively when the tools are on PATH (see DEVIATIONS D4)
    if command -v sta >/dev/null 2>&1; then
        exec bash -c "$*"
    fi
    echo "ERROR: OL_IMAGE is not set and could not be detected, and no native sta on PATH." >&2
    exit 1
fi

exec docker run --rm \
    --user "$(id -u):$(id -g)" \
    -e HOME="$HOME" \
    -e PDK_ROOT \
    -e PDK \
    -v "$HOME:$HOME" \
    -w "$PWD" \
    "$OL_IMAGE" bash -c "$*"
